    <rest_method/>
    <rest_method_text/>
    <rest_service/>
    <rest_service_text/>
    <rest_variables/>
    <role_conditions/>
    <script><![CDATA[
var prId = current.getValue('purchase_requisition');
if (prId) {
  var lineGr = new GlideRecord('x_528401_purchas_0_pr_line');
  lineGr.addQuery('purchase_requisition', prId);
  lineGr.query();
  var total = 0;
  while (lineGr.next()) {
    total += parseFloat(lineGr.getValue('total_price') || '0');
  }
  var prGr = new GlideRecord('x_528401_purchas_0_pr');
  if (prGr.get(prId)) {
    prGr.setValue('total_amount', total);
    prGr.setWorkflow(false);
    prGr.update();
  }
}
]]></script>
    <sys_name>PR - Recalculate Total Amount</sys_name>
    <sys_policy/>
    <template/>
    <when>after</when>
